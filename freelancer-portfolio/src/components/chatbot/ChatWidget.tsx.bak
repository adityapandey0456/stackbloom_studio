"use client";

import { useEffect, useRef, useState, type FormEvent } from "react";
import { MessageCircle, Send, X } from "lucide-react";

type Message = {
  role: "assistant" | "user";
  text: string;
};

const suggestions = [
  "What services do you offer?",
  "How much will my project cost?",
  "How long does delivery take?",
  "I want to discuss a project",
];

function getReply(message: string): string {
  const text = message.toLowerCase();

  if (/price|cost|budget|charge|pricing|kitna|paise/.test(text)) {
    return (
      "Pricing depends on your project scope, features and complexity. " +
      "Share your requirements and budget range using the enquiry form. " +
      "Aditya will review them before confirming a quotation."
    );
  }

  if (/time|deadline|delivery|duration|days|kab/.test(text)) {
    return (
      "The delivery timeline depends on the agreed scope and availability. " +
      "Include your preferred deadline in the enquiry form so Aditya can " +
      "confirm a realistic schedule."
    );
  }

  if (/dashboard|excel|analysis|analytics|data/.test(text)) {
    return (
      "Aditya offers data analysis, Excel dashboards and reporting solutions. " +
      "Describe your data sources, the insights you need and your preferred " +
      "output in the enquiry form. Please avoid sharing confidential data here."
    );
  }

  if (/automation|python|script/.test(text)) {
    return (
      "Aditya can help with Python scripts, data processing and practical " +
      "workflow automation. Tell him which task you repeat, your input files " +
      "and the result you want."
    );
  }

  if (/fix|bug|repair|error|existing/.test(text)) {
    return (
      "For an existing website, describe the issue, the technology used and " +
      "the affected page in the enquiry form. Do not send passwords or " +
      "private API keys."
    );
  }

  if (/services|offer|help|provide/.test(text)) {
    return (
      "Services include business websites, landing pages, website fixes, " +
      "data dashboards and Python automation. What would you like help with?"
    );
  }

  if (/portfolio|previous|sample|work|example/.test(text)) {
  return (
    "The Work section features D-Finance, JobPilot AI, an Indian " +
    "Sign Language learning system, a Kotlin ticket machine and " +
    "NailGuard. Each card links to its GitHub repository. " +
    "D-Finance also has a website link."
  );
}
  if (/website|landing|web development/.test(text)) {
    return (
      "For a new website, share your business type, required pages, " +
      "features and any reference websites. Mention whether you already " +
      "have a domain, hosting, images and written content."
    );
  }

  if (/contact|enquiry|discuss|hire|start|project|quote/.test(text)) {
    return (
      "Use the “Open enquiry form” link below to share your name, email " +
      "and project requirements. Final scope, price and timeline will be " +
      "confirmed by Aditya after review."
    );
  }

  if (/^(hi|hello|hey|namaste)\b/.test(text)) {
    return (
      "Hi! I'm Aditya's project assistant. I can explain the services, " +
      "quotation process and how to submit a project enquiry. What do you need?"
    );
  }

  return (
    "I can help with services, website projects, dashboards, automation, " +
    "pricing process and delivery questions. For a specific requirement, " +
    "please use the enquiry form so Aditya can review it."
  );
}

export default function ChatWidget() {
  const [open, setOpen] = useState(false);
  const [input, setInput] = useState("");
  const [messages, setMessages] = useState<Message[]>([
    {
      role: "assistant",
      text:
        "Hi! I'm Aditya's project assistant. What would you like to build?",
    },
  ]);

  const messagesRef = useRef<HTMLDivElement>(null);
  const inputRef = useRef<HTMLInputElement>(null);
  const launcherRef = useRef<HTMLButtonElement>(null);

  useEffect(() => {
    if (open) {
      inputRef.current?.focus();
    }
  }, [open]);

  useEffect(() => {
    if (messagesRef.current) {
      messagesRef.current.scrollTop =
        messagesRef.current.scrollHeight;
    }
  }, [messages, open]);

  function sendMessage(value: string) {
    const text = value.trim().slice(0, 500);

    if (!text) return;

    setMessages((previous) => [
      ...previous,
      { role: "user", text },
      { role: "assistant", text: getReply(text) },
    ]);

    setInput("");
    inputRef.current?.focus();
  }

  function handleSubmit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    sendMessage(input);
  }

  function closeChat() {
    setOpen(false);
    launcherRef.current?.focus();
  }

  return (
    <div className="chat-widget">
      {open && (
        <section
          id="project-chat"
          className="chat-window"
          role="dialog"
          aria-labelledby="chat-title"
          onKeyDown={(event) => {
            if (event.key === "Escape") {
              closeChat();
            }
          }}
        >
          <div className="chat-header">
            <div>
              <strong id="chat-title">Project Assistant</strong>
              <span>Aditya&apos;s guided website assistant</span>
            </div>

            <button
              type="button"
              className="chat-icon-button"
              onClick={closeChat}
              aria-label="Close chat"
            >
              <X size={20} />
            </button>
          </div>

          <div
            className="chat-messages"
            ref={messagesRef}
            role="log"
            aria-live="polite"
            aria-relevant="additions"
          >
            {messages.map((message, index) => (
              <div
                key={index}
                className={`chat-bubble chat-${message.role}`}
              >
                <span className="chat-speaker">
                  {message.role === "assistant" ? "Assistant" : "You"}
                </span>
                <p>{message.text}</p>
              </div>
            ))}
          </div>

          <div className="chat-suggestions">
            {suggestions.map((suggestion) => (
              <button
                key={suggestion}
                type="button"
                onClick={() => sendMessage(suggestion)}
              >
                {suggestion}
              </button>
            ))}
          </div>

          <a
            href="/#contact"
            className="chat-contact-link"
            onClick={() => setOpen(false)}
          >
            Open enquiry form ↗
          </a>

          <form className="chat-input-form" onSubmit={handleSubmit}>
            <label className="chat-sr-only" htmlFor="chat-input">
              Your question
            </label>

            <input
              ref={inputRef}
              id="chat-input"
              value={input}
              onChange={(event) => setInput(event.target.value)}
              placeholder="Ask about your project..."
              maxLength={500}
              autoComplete="off"
            />

            <button
              type="submit"
              aria-label="Send message"
              disabled={!input.trim()}
            >
              <Send size={18} />
            </button>
          </form>

          <p className="chat-note">
            Messages stay in this page session and are not submitted
            as enquiries.
          </p>
        </section>
      )}

      <button
        ref={launcherRef}
        type="button"
        className="chat-launcher"
        aria-expanded={open}
        aria-controls="project-chat"
        onClick={() => {
          if (open) closeChat();
          else setOpen(true);
        }}
      >
        {open ? <X size={21} /> : <MessageCircle size={21} />}
        <span>{open ? "Close chat" : "Let's chat"}</span>
      </button>
    </div>
  );
}